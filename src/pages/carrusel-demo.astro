---
import Layout from "../layouts/Layout.astro";

// Import images
import img1 from "../assets/Portada-Facebook.png";
import img2 from "../assets/01.png";
import img3 from "../assets/02.png";
import img4 from "../assets/03.png";
import img5 from "../assets/PortadaWeb-copia-scaled.jpg";

// Define slides data
const slidesData = [
  {
    image: img1.src,
    title: "Depilación Láser",
    description: "Equipamiento Soprano Ice Platinum - El más avanzado del mercado"
  },
  {
    image: img2.src,
    title: "Medicina Estética",
    description: "Tratamientos con tecnología de punta"
  },
  {
    image: img3.src,
    title: "Cuidado Facial",
    description: "Procedimientos personalizados para tu tipo de piel"
  },
  {
    image: img4.src,
    title: "Tratamientos Corporales",
    description: "Soluciones integrales para el bienestar"
  },
  {
    image: img5.src,
    title: "Centro Certificado",
    description: "Dra. Perla Adriana Albornoz - MN: 7034"
  }
];
---

<Layout>
  <div class="mx-auto max-w-4xl gap-6 px-4 py-8">
    <h1 class="text-4xl font-bold mb-6 text-center">Demo - Carrusel Vue</h1>
    
    <div class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Carrusel con Autoplay (3s)</h2>
      <div id="carousel1"></div>
    </div>

    <div class="mb-12">
      <h2 class="text-2xl font-semibold mb-4">Carrusel sin Autoplay (solo navegación manual)</h2>
      <div id="carousel2"></div>
    </div>

    <div class="bg-base-200 p-6 rounded-lg">
      <h3 class="text-xl font-bold mb-4">📋 Propiedades del Componente</h3>
      <ul class="space-y-2 text-sm">
        <li><strong>slides:</strong> Array de objetos con { image, title?, description? }</li>
        <li><strong>autoplay:</strong> boolean (default: true)</li>
        <li><strong>interval:</strong> number en ms (default: 3000)</li>
        <li><strong>pauseOnHover:</strong> boolean (default: true)</li>
      </ul>
    </div>

    <div class="bg-base-200 p-6 rounded-lg mt-6">
      <h3 class="text-xl font-bold mb-4">🎯 Características</h3>
      <ul class="space-y-2 text-sm list-disc list-inside">
        <li>✅ Desplazamiento automático configurable</li>
        <li>✅ Navegación manual (botones anterior/siguiente)</li>
        <li>✅ Indicadores interactivos (dots)</li>
        <li>✅ Pausa en hover, reanuda al salir</li>
        <li>✅ Ciclo infinito (wrap circular)</li>
        <li>✅ Transiciones suaves</li>
        <li>✅ Accesibilidad (aria-labels)</li>
      </ul>
    </div>
  </div>

  <script define:vars={{ slidesData }}>
    import Carrusel from "../components/vue/Carrusel.vue";
    import { createApp } from "vue";

    // Mount carousel 1 with autoplay
    const app1 = createApp(Carrusel, {
      slides: slidesData,
      autoplay: true,
      interval: 3000,
      pauseOnHover: true,
    });
    app1.mount("#carousel1");

    // Mount carousel 2 without autoplay
    const app2 = createApp(Carrusel, {
      slides: slidesData,
      autoplay: false,
      pauseOnHover: true,
    });
    app2.mount("#carousel2");
  </script>
</Layout>
