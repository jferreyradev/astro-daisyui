---
const { title, paragraph, sm } = Astro.props;
---

<section class="md:col-span-6 ">
  <div class="items-center text-center rounded-xl bg-white p-6">
    <h1 class="text-4xl text-base-content/50 font-normal" style="text-align: center;">{title}</h1>
    <p class="mt-2 text-gray-600">{paragraph}</p>
    <div class={`mt-6 grid justify-items-center ${sm || ''}`}>
      <slot></slot>
    </div>
  </div>
</section>
