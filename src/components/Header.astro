---
import { Image } from 'astro:assets';
import Logo from "../assets/LogoMasEsthetic.png"
---

<header class="navbar bg-base-100  sticky top-0 z-10">
  <div class="navbar bg-base-100 ">
    <Image  src={Logo} alt="Logo" width="150" height="80"/>   
  </div>
  <div class="navbar-center hidden lg:flex ">
    <ul class="menu menu-horizontal px-1 text-base">
      <li><a>Inicio</a></li>
      <li><a>Centro certificado</a></li>
      <li>
        <details>
          <summary>Depilación Láser</summary>
          <ul class="p-2 bg-base-100 w-40 z-10">
            <li><a>Zonas</a></li>
            <li><a>Soprano Titanium</a></li>
          </ul>
        </details>
      </li>
      <li>
        <details>
          <summary>Servicios</summary>
          <ul class="p-2 bg-base-100 w-40 z-10">
            <li><a>Método Soprano</a></li>
            <li><a>Tratamientos corporales</a></li>
          </ul>
        </details>
      </li>
      <li>
        <details>
          <summary>Sucursales</summary>
          <ul class="p-2 bg-base-100 w-40 z-10">
            <li><a>San Miguel de Tucumán</a></li>
            <li><a>Yerba Buena</a></li>
          </ul>
        </details>
      </li>
      <li><a>Novedades</a></li>
    </ul>
  </div>
  <div class="dropdown dropdown-end lg:hidden">
    <label tabindex="0" class="btn btn-ghost">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
      </svg>
    </label>
    <ul class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-3 w-52 p-2 shadow">
      <li><a>Inicio</a></li>
      <li><a>Centro Certificado</a></li>
      <li>
        <a>Depilación Láser</a>
        <ul class="p-2">
          <li><a>Zonas</a></li>
          <li><a>Soprano Titanium</a></li>
        </ul>
      </li>
      <li>
        <a>Servicios</a>
        <ul class="p-2">
          <li><a>Método Soprano</a></li>
          <li><a>Tratamientos corporales</a></li>
        </ul>
      </li>
      <li>
        <a>Sucursales</a>
        <ul class="p-2">
          <li><a>San Miguel de Tucumán</a></li>
          <li><a>Yerba Buena</a></li>
        </ul>
      </li>
      <li><a>Novedades</a></li>
    </ul>
  </div>
</header>

<script>
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      const active = document.activeElement;
      if (active instanceof HTMLElement) {
        active.blur();
      }

      const dropdown = document.querySelector('.dropdown');
      if (dropdown) {
        dropdown.classList.remove('dropdown-open');
      }
    }
  });
</script>