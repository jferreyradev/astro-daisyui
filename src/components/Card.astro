---

const { title, paragraph,width,img} = Astro.props;
import { Image } from 'astro:assets';
---
<div class={`card bg-base-100 ${width || ''} shadow-sm`}>
  
  <figure>
    <Image src={img} alt="" />
  </figure>
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p>{paragraph}</p>
  </div>
</div>
