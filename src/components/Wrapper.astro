
---
import Header from "./Header.astro"
import Content from "./Content.astro"
import Footer from "./Footer.astro"
import Card from "./Card.astro"
import Carousel from "./Carousel.astro"

import WhatsappChatButton from "./WhatsappChatButton.astro"

import Carrusel from "./vue/Carrusel.vue"


import img1 from "../assets/Corporal.webp"
import img2 from "../assets/Depilacion.webp"
import img3 from "../assets/Facial.webp"
import img4 from "../assets/Medicina.webp"
import img5 from "../assets/web1.webp"
import img6 from "../assets/web2.webp"
import img7 from "../assets/web3.webp"
import MiniCarousel from "./MiniCarousel.astro"

// Carousel slides data

---

<body>
    <Header></Header>
    <div class="items-center text-center mx-auto grid w-full max-w-6xl gap-6 px-4 py-8 md:grid-cols-12 min-h-screen">
    
       
      <div class="items-center text-center md:col-span-12 font-sans font-normal text-gray-700">
      <Content title="" paragraph="" >      
       
        <Carousel />

      </Content>
      <WhatsappChatButton />
      <Content  title="Nuestros Servicios" paragraph="" sm="sm:grid-cols-4" >      
        <Card title="" paragraph="" width="w-60" img={img1}></Card>
        <Card title="" paragraph="" width="w-60" img={img2}></Card>
        <Card title="" paragraph="" width="w-60" img={img3}></Card>
        <Card title="" paragraph="" width="w-60" img={img4}></Card>
     </Content>
     <Content title="Novedades" paragraph="" sm="sm:grid-cols-3">      
        <Card title="Contamos con equipo propio Platinum | Depilación láser" paragraph="" width="w-90" img={img5}></Card>
        <Card title="Pellet- Nuevo tratamiento a cargo de la Dra. Perla Albornoz" paragraph="" width="w-90" img={img6}></Card>
        <Card title="Viví el verano libre de vellos" paragraph="" width="w-90" img={img7}></Card>         
     </Content>     
      </div>

