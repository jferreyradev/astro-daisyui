
---
import Header from "./Header.astro"
import Aside from "./Aside.astro"
import Content from "./Content.astro"
import Footer from "./Footer.astro"
import Card from "./Card.astro"
import Carousel from "./Carousel.astro"
import WhatsappChatButton from "./WhatsappChatButton.astro"



import img1 from "../assets/Corporal.png"
import img2 from "../assets/Depilacion.png"
import img3 from "../assets/Facial.png"
import img4 from "../assets/Medicina.png"
import img5 from "../assets/web1.png"
import img6 from "../assets/web2.png"
import img7 from "../assets/web3.png"
---

<body>
    <Header></Header>
    <div class="mx-auto grid w-full max-w-6xl gap-6 px-4 py-8 md:grid-cols-12 min-h-screen">
    
       
      <div class="md:col-span-12">
      <Content title="" paragraph="" >      
       <Carousel autoplay={true} interval={4000}/>  
      </Content>
       <WhatsappChatButton />
      <Content title="Nuestros Servicios" paragraph="" sm="sm:grid-cols-4" >      
        <Card title="" paragraph="" width="w-60" img={img1}></Card>
         <Card title="" paragraph="" width="w-60" img={img2}></Card>
          <Card title="" paragraph="" width="w-60" img={img3}></Card>
         <Card title="" paragraph="" width="w-60" img={img4}></Card>
     </Content>
     <Content title="Novedades" paragraph="" sm="sm:grid-cols-3">      
        <Card title="Contamos con equipo propio Platinum | Depilación láser" paragraph="Texto de ejemplo." width="w-90" img={img5}></Card>
         <Card title="Pellet- Nuevo tratamiento a cargo de la Dra. Perla Albornoz" paragraph="Texto de ejemplo." width="w-90" img={img6}></Card>
          <Card title="Viví el verano libre de vellos" paragraph="Texto de ejemplo." width="w-90" img={img7}></Card>
         
     </Content>
      </div>
